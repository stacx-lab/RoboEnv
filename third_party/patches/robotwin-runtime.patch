@@ -277,6 +304,45 @@ except Exception as e:
 
 
 # ********************** MplibPlanner **********************
+
+# --------------------------------------------------------------------------- local patch
+# Planner effort is controlled by environment variables so a replay can reproduce the
+# conditions of the run that produced a solution:
+#   CAPX_PLANNER_GENEROUS=1  -> replay defaults (mplib 5 s, curobo 10 attempts)
+#   CAPX_PLANNER_TIME=<s>    -> explicit wall-clock budget for mplib planning_time AND the
+#                               curobo MotionGenPlanConfig.timeout (overrides GENEROUS)
+#   CAPX_PLANNER_SEED=<int>  -> seed OMPL's global RNG (mplib.set_global_seed) so RRT sampling
+#                               is a fixed sequence; the found path then depends only on the
+#                               seed and on the budget being large enough to reach it.
+def _planner_time_s(agent_default, generous_default):
+    explicit = os.environ.get("CAPX_PLANNER_TIME")
+    if explicit:
+        return float(explicit)
+    return generous_default if os.environ.get("CAPX_PLANNER_GENEROUS") else agent_default
+
+
+def _curobo_plan_config(**kwargs):
+    kwargs.setdefault("max_attempts", 10 if os.environ.get("CAPX_PLANNER_GENEROUS") else 4)
+    explicit = os.environ.get("CAPX_PLANNER_TIME")
+    if explicit:
+        kwargs.setdefault("timeout", float(explicit))
+    return MotionGenPlanConfig(**kwargs)
+
+
+def _seed_planners_from_env():
+    seed = os.environ.get("CAPX_PLANNER_SEED")
+    if seed is None or seed == "":
+        return
+    try:
+        import mplib
+
+        mplib.set_global_seed(int(seed))
+    except Exception as exc:  # noqa: BLE001
+        print(f"[planner] CAPX_PLANNER_SEED ignored: {exc}")
+
+
+_seed_planners_from_env()
+
