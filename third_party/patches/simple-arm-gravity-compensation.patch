--- /dev/null
+++ b/src/simple/robots/arm_gravity.py
@@ -0,0 +1,31 @@
+"""Gravity-only arm feedforward; scratch state never touches the live solver."""
+
+import mujoco
+import numpy as np
+
+
+class ArmGravityCompensation:
+    def __init__(self, model, arm_names, body_joint_ids):
+        self.model = model
+        self.data = mujoco.MjData(model)
+        self.forces = np.zeros(model.nv)
+        ids = [model.joint(name).id for name in arm_names]
+        if len(ids) != 14 or len(set(ids)) != 14:
+            raise ValueError("Expected fourteen distinct arm joints")
+        if any(model.jnt_type[index] != mujoco.mjtJoint.mjJNT_HINGE for index in ids):
+            raise ValueError("Arm gravity compensation requires scalar hinge joints")
+        self.dofs = model.jnt_dofadr[ids]
+        body_ids = list(body_joint_ids)
+        self.slots = [body_ids.index(index) for index in ids]
+        self.torque = np.zeros(len(body_ids))
+
+    def __call__(self, live):
+        self.data.qpos[:] = live.qpos
+        # Scratch qvel stays zero: live qfrc_bias would also cancel Coriolis and
+        # centrifugal forces. Refresh only the quantities required by mj_rne.
+        mujoco.mj_kinematics(self.model, self.data)
+        mujoco.mj_comPos(self.model, self.data)
+        mujoco.mj_comVel(self.model, self.data)
+        mujoco.mj_rne(self.model, self.data, 0, self.forces)
+        self.torque[self.slots] = self.forces[self.dofs]
+        return self.torque
