+def __getattr__(name):
+    optional = {
+        "DataWrapper": "data_wrapper",
+        "DataPlaybackWrapper": "data_wrapper",
+        "HDF5CollectionWrapper": "hdf5_data_wrapper",
+        "HDF5PlaybackWrapper": "hdf5_data_wrapper",
+    }
+    if name in optional:
+        try:
+            module = import_module("omnigibson.envs." + optional[name])
+        except ModuleNotFoundError as exc:
+            if exc.name == "av" or (exc.name or "").startswith("av."):
+                raise ImportError("Data recording wrappers require the omnigibson[recording] extra") from exc
+            raise
+        return getattr(module, name)
+    if name in {"LeRobotDataWrapper", "LeRobotPlaybackWrapper"}:
+        try:
+            from omnigibson.envs import lerobot_data_wrapper
+        except ModuleNotFoundError as exc:
+            if exc.name == "lerobot" or (exc.name or "").startswith("lerobot."):
+                raise ImportError("LeRobot wrappers require the omnigibson[dataset] extra") from exc
+            raise
+        return getattr(lerobot_data_wrapper, name)
+    raise AttributeError(name)
