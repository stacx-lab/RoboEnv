+def optical_depth(depth, near, far):
+    """Cycles perspective Z is already optical-axis depth in scene metres."""
+    valid = np.isfinite(depth) & (depth > near) & (depth < far)
+    return np.where(valid, depth, 0).astype(np.float32)
