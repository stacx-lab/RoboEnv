diff --git a/capx/utils/promptkit.py b/capx/utils/promptkit.py
new file mode 100644
index 0000000..137839d
--- /dev/null
+++ b/capx/utils/promptkit.py
@@ -0,0 +1,28 @@
+"""Compatibility shim — prompt sections and skill loading now live in roboenv-runtime (refactor P2).
+
+``PromptSpec`` is :class:`roboenv_runtime.prompt.PromptSpec`; ``load_skills``/``render_skills`` read the
+roboenv-runtime knowledge store (``skills/knowledge/shared/<domain>``) instead of ``capx/skills/<domain>``.
+"""
+
+from __future__ import annotations
+
+from roboenv_runtime.prompt import PromptSpec  # noqa: F401
+from roboenv_runtime.skills.store import SkillStore, default_store
+
+
+def load_skills(domain: str, names: list[str] | None = None, kinds: list[str] | None = None) -> list[dict]:
+    """Skill records for a domain (same dict shape as before)."""
+    skills = default_store().shared([domain], kinds=kinds, names=names)
+    return [
+        {"name": s.name, "kind": s.kind, "confidence": s.confidence, "source": s.source, "body": s.body}
+        for s in skills
+    ]
+
+
+def render_skills(skills: list[dict]) -> str:
+    """Render skill records as a prompt section (empty string if none)."""
+    if not skills:
+        return ""
+    lines = ["Field notes from previous work on this platform (hard-won; trust them):"]
+    lines += [f"- [{rec['kind'] or 'note'}] {rec['body']}" for rec in skills]
+    return "\n".join(lines)
