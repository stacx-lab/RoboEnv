+"""ARX X5 (RoboDojo) APIs.
+
+Self-registering: importing this package makes the API names resolvable through
+`capx.integrations.base_api.get_api`, so RoboDojo configs work without editing
+`capx/integrations/__init__.py`. The task env module imports this package, which
+runs before `CodeExecutionEnvBase` looks the API up.
+"""
+
+from capx.integrations.base_api import register_api
+
+from .robodojo_planner import RoboDojoPlannerPrivilegedApi
+
+register_api("RoboDojoPlannerPrivilegedApi", RoboDojoPlannerPrivilegedApi)
+
+__all__ = ["RoboDojoPlannerPrivilegedApi"]
