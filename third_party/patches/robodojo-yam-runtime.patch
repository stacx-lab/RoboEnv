index 0000000..003d06a
--- /dev/null
+++ b/env/robot_manager/robot_config/yam.py
@@ -0,0 +1,60 @@
+from isaaclab.actuators import ImplicitActuatorCfg
+from isaaclab.assets.articulation import ArticulationCfg
+import isaaclab.sim as sim_utils
+
+from env.global_configs import ROBOTS_PATH
+
+
+def get_robot_config():
+    return ArticulationCfg(
+        spawn=sim_utils.UsdFileCfg(
+            usd_path=f"{ROBOTS_PATH}/yam/YAM.usd",
+            rigid_props=sim_utils.RigidBodyPropertiesCfg(
+                disable_gravity=True,
+                max_depenetration_velocity=5.0,
+            ),
+            articulation_props=sim_utils.ArticulationRootPropertiesCfg(
+                # PhysX self-collision OFF: the injected convex-hull colliders
+                # (visual-mesh copies) interpenetrate between gripper body and
+                # finger tips and jam the gripper closed; planning-time
+                # self-collision is curobo's job anyway
+                enabled_self_collisions=False,
+                solver_position_iteration_count=8,
+                solver_velocity_iteration_count=0,
+                fix_root_link=True,
+            ),
+        ),
+        init_state=ArticulationCfg.InitialStateCfg(
+            joint_pos={
+                "joint1": 0.0,
+                "joint2": 0.0,
+                "joint3": 0.0,
+                "joint4": 0.0,
+                "joint5": 0.0,
+                "joint6": 0.0,
+                "joint7": 0.0,
+                "joint8": 0.0,
+            },
+            pos=(0.25, -0.25, 0.0),
+            rot=(0.707, 0, 0, 0.707),
+        ),
+        actuators={
+            "arm": ImplicitActuatorCfg(
+                joint_names_expr=["joint[1-6]"],
+                effort_limit_sim=100.0,
+                velocity_limit_sim=5.0,
+                stiffness=4400.0,
+                damping=40.0,
+                armature=0.01,
+            ),
+            "gripper": ImplicitActuatorCfg(
+                joint_names_expr=["joint7", "joint8"],
+                # thin-wall pinches (bowl rims ~5mm) need real clamp force:
+                # at X5-like gains the pad normal force barely beats the
+                # bowl's weight and lifts slip. 8k/400 measured to hold.
+                effort_limit_sim=400.0,
+                stiffness=8000,
+                damping=200,
+            ),
+        },
+    )
